{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"allowJs": true,
		"checkJs": false,
		"isolatedModules": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"verbatimModuleSyntax": true,
		"types": ["svelte"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
