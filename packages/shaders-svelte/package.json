{
	"name": "@devmischief/shaders-svelte",
	"version": "0.0.4",
	"description": "Svelte components for @paper-design/shaders",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
