		"@sveltejs/package": "^2.3.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@10.17.1"
